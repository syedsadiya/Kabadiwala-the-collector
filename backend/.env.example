# Supabase PostgreSQL connection string. Use the backend/server connection string,
# not a frontend/public key. Keep this secret and configure it in the host.
DATABASE_URL=postgresql://postgres:syedsadiya%40123@db.rwofumsicpubjxmekayq.supabase.co:5432/postgres
# Optional path to the read-only SQLite source used by npm run migrate:sqlite
# SQLITE_SOURCE=./kabadiwala.sqlite

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Port the API listens on (Render sets this automatically in production)
PORT=5000

# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# AI Recycling Assistant (keep the real key in backend/.env, never in frontend files)
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
